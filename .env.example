# Ortam değişkenleri örneği — .env.local olarak kopyalayıp doldurun.
# (Şu an kod bu değişkenleri zorunlu kılmıyor; ileride entegrasyonlar için hazır.)

# Site kök adresi (SEO/sitemap için; src/config/site.ts içindeki domain ile eşleşmeli)
NEXT_PUBLIC_SITE_URL=https://ornek-klinik.com

# Form bildirimi — kliniğin kendi SMTP hesabı (info@meurology.com) üzerinden.
# Değerleri cPanel → Email Accounts → (hesap) → "Connect Devices" / "Configure Mail
# Client" ekranından alın. Boş/yanlışsa e-posta atlanır ama başvuru yine başarılı
# sayılır (hata sunucu loguna yazılır). ŞİFRE ASLA koda/örnek dosyaya yazılmaz.
SMTP_HOST=            # ör. mail.meurology.com
SMTP_PORT=465         # 465 (SSL) veya 587 (STARTTLS)
SMTP_SECURE=true      # 465 için true, 587 için false
SMTP_USER=info@meurology.com
SMTP_PASS=            # mail hesabının şifresi (cPanel'den)
# Bildirimlerin gideceği adres (boşsa SMTP_USER'a, yani kendine gönderir)
# LEAD_NOTIFICATION_EMAIL=info@meurology.com

# Google yorumlarını otomatik çekmek için (Google Places API).
# İkisi de girilince Hasta Deneyimleri sayfasında Google yorumları görünür.
# GOOGLE_PLACES_API_KEY=
# GOOGLE_PLACE_ID=

# Özel Online Danışmanlık — opsiyonel entegrasyonlar (gerçek anahtarları buraya girin)
# NOT: Video görüşme WhatsApp üzerinden yapılır; Zoom/Meet/Whereby ANAHTARI GEREKMEZ.
# Cal.com (opsiyonel randevu takvimi — boşsa site içi hafif planlayıcı kullanılır)
# CALCOM_API_KEY=
# NEXT_PUBLIC_CALCOM_LINK=
# Randevu bildirimi için e-posta servisi (opsiyonel)
# CONSULT_NOTIFICATION_EMAIL=
