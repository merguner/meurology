# Ortam değişkenleri örneği — .env.local olarak kopyalayıp doldurun.
# (Şu an kod bu değişkenleri zorunlu kılmıyor; ileride entegrasyonlar için hazır.)

# Site kök adresi (SEO/sitemap için; src/config/site.ts içindeki domain ile eşleşmeli)
NEXT_PUBLIC_SITE_URL=https://ornek-klinik.com

# Form bildirimi — kliniğin kendi SMTP hesabı (info@meurology.com) üzerinden.
# Değerleri cPanel → Email Accounts → (hesap) → "Connect Devices" / "Configure Mail
# Client" ekranından alın. Boş/yanlışsa e-posta atlanır ama başvuru yine başarılı
# sayılır (hata sunucu loguna yazılır). ŞİFRE ASLA koda/örnek dosyaya yazılmaz.
SMTP_HOST=            # ör. mail.meurology.com
SMTP_PORT=465         # 465 (SSL) veya 587 (STARTTLS)
SMTP_SECURE=true      # 465 için true, 587 için false
SMTP_USER=info@meurology.com
SMTP_PASS=            # mail hesabının şifresi (cPanel'den)
# Bildirimlerin gideceği adres (boşsa SMTP_USER'a, yani kendine gönderir)
# LEAD_NOTIFICATION_EMAIL=info@meurology.com

# Google yorumlarını otomatik çekmek için (Google Places API).
# İkisi de girilince Hasta Deneyimleri sayfasında Google yorumları görünür.
# GOOGLE_PLACES_API_KEY=
# GOOGLE_PLACE_ID=

# Özel Online Danışmanlık — opsiyonel entegrasyonlar (gerçek anahtarları buraya girin)
# NOT: Video görüşme WhatsApp üzerinden yapılır; Zoom/Meet/Whereby ANAHTARI GEREKMEZ.
# Cal.com (opsiyonel randevu takvimi — boşsa site içi hafif planlayıcı kullanılır)
# CALCOM_API_KEY=
# NEXT_PUBLIC_CALCOM_LINK=
# Randevu bildirimi için e-posta servisi (opsiyonel)
# CONSULT_NOTIFICATION_EMAIL=

# ---------------------------------------------------------------------------
# Ön değerlendirme formu — dosya ekleri
# ---------------------------------------------------------------------------
# Hastanın eklediği belgeler SUNUCUDA SAKLANMAZ; yalnızca kliniğe giden
# bildirim e-postasına iliştirilir. Ek bir ortam değişkeni GEREKMEZ.
# PDF/JPG/PNG, en fazla 3 dosya, dosya başına 10 MB (src/lib/formAttachments.ts).

# Test ve yerel geliştirme: 1 iken HİÇBİR e-posta gönderilmez; mesajlar
# yalnızca bellekte tutulur. Üretimde TANIMLAMAYIN.
# MAIL_FAKE=1

# NOT — RESEND_API_KEY / FORM_TO_EMAIL kullanılmıyor.
# Form akışı bozuk değildi: gönderim kliniğin kendi SMTP hesabı üzerinden
# çalışıyor (yukarıdaki SMTP_* değişkenleri). Üçüncü parti bir e-posta
# servisi eklemek, hasta verisini yurt dışındaki ek bir işleyiciye
# göndermek anlamına gelirdi; KVKK açısından mevcut yol daha az yük
# getirdiği için korundu. FORM_TO_EMAIL'in karşılığı LEAD_NOTIFICATION_EMAIL.

# ---------------------------------------------------------------------------
# Ölçümleme — ikisi de RIZAYA BAĞLIDIR
# ---------------------------------------------------------------------------
# Hiçbiri tanımlı değilse çerez onay bandı GÖRÜNMEZ ve sitede zorunlu çerez
# dışında bir şey yoktur. Tanımlıysa bant görünür; onay verilmeden tek bir
# ağ çağrısı yapılmaz (betikler DOM'a onaydan sonra eklenir).
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_META_PIXEL_ID=

# Olaylar: whatsapp_click (kaynak etiketiyle), phone_click, email_click,
# form_submit, consultation_slot_selected, language_switch.
# SAĞLIK VERİSİ olay parametresi olarak GÖNDERİLMEZ — yalnızca sayfa yolu
# ve kısa kaynak etiketi gider (bkz. src/lib/analytics.ts).
